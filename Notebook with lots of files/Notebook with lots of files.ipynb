    "import os\n",
    "\n",
    "for i in range(100):\n",
    "    os.makedirs(str(i), exist_ok=True)\n",
    "    for j in range(100):\n",
    "        file_path = os.path.join(str(i), f\"{j}.py\")\n",
    "        with open(file_path, \"w\") as f:\n",
    "            f.write(str(j))"
